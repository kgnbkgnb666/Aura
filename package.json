    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "^5.6.3",
    "vite": "^8.1.5"
  }
